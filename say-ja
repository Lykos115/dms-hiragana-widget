#!/bin/sh
# say-ja: speak Japanese text with Piper (https://github.com/OHF-Voice/piper1-gpl).
#   pipx install "piper-tts[http]"          # or: pip install --user "piper-tts[http]"
#   python3 -m piper.download_voices ja_JA-hi_fi_captain-medium --data-dir ~/.local/share/piper
#   install -Dm755 say-ja ~/.local/bin/say-ja
# Then set the plugin's text-to-speech command to:  say-ja {text}
#
# The CLI reloads the model on every call (about a second). For instant
# playback start the server once (e.g. niri spawn-at-startup) and this script
# will use it automatically:
#   python3 -m piper.http_server -m ja_JA-hi_fi_captain-medium --data-dir ~/.local/share/piper
VOICE="${PIPER_VOICE:-ja_JA-hi_fi_captain-medium}"
DATA="${PIPER_DATA_DIR:-$HOME/.local/share/piper}"
PORT="${PIPER_PORT:-5000}"
[ -n "$1" ] || exit 0
if curl -sf "http://localhost:$PORT/info" >/dev/null 2>&1; then
    json=$(printf '%s' "$1" | python3 -c 'import json,sys; print(json.dumps({"text": sys.stdin.read().strip()}))')
    curl -sf -X POST -H 'Content-Type: application/json' -d "$json" "http://localhost:$PORT/synthesize" \
        | ffplay -nodisp -autoexit -loglevel quiet -
else
    exec piper -m "$VOICE" --data-dir "$DATA" -- "$1"
fi
