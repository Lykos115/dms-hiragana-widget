#!/bin/sh
# say-ja: speak Japanese text with Piper (https://github.com/OHF-Voice/piper1-gpl).
#
#   pipx install "piper-tts[http,ja]"  # ja = Japanese phonemizer (OpenJTalk), http = server
#   install -Dm755 say-ja ~/.local/bin/say-ja
#   say-ja setup                       # downloads the ja_JA-hi_fi_captain-medium voice
#   say-ja テスト                       # try it (plays with pw-play / paplay / mpv / ffplay)
#   tail ~/.cache/say-ja.log            # errors land here when the widget calls it
#
# Then set the plugin's text-to-speech command to:  say-ja {text}
#
# The CLI reloads the model on every call (about a second). For instant
# playback run `say-ja server` once (e.g. niri spawn-at-startup) and this
# script uses it automatically.
#
# PIPER_SPEAKER=male, PIPER_LENGTH_SCALE=1.2 (slower) and PIPER_VOICE override
# the defaults; set them in ~/.config/environment.d/ or a wrapper.
#
# `setup` and `server` run Piper's modules with the Python that owns the
# `piper` command (pipx venv, virtualenv or system), so `python3 -m piper...`
# is never needed.

# DMS is started by the compositor, not by a login shell, so ~/.local/bin (pipx)
# is usually missing from its PATH. Add it here, and log what happens because
# stderr goes nowhere when the widget runs this.
PATH="$HOME/.local/bin:$PATH"; export PATH
LOG="${PIPER_LOG:-${XDG_CACHE_HOME:-$HOME/.cache}/say-ja.log}"
mkdir -p "$(dirname "$LOG")" 2>/dev/null
if [ "$1" != "setup" ] && [ "$1" != "server" ]; then
    exec 2>>"$LOG"
    echo "$(date '+%F %T') say-ja: $1" >&2
fi

VOICE="${PIPER_VOICE:-ja_JA-hi_fi_captain-medium}"
DATA="${PIPER_DATA_DIR:-$HOME/.local/share/piper}"
PORT="${PIPER_PORT:-5000}"
SPEAKER="${PIPER_SPEAKER:-female}"          # the voice has 'female' and 'male'
LENGTH_SCALE="${PIPER_LENGTH_SCALE:-1.0}"    # >1 = slower, e.g. 1.2 for single kana

piper_python() {
    bin=$(command -v piper) || { echo "say-ja: 'piper' not found, run: pipx install \"piper-tts[http,ja]\"" >&2; exit 1; }
    # pipx launchers are scripts whose shebang points into the venv; symlinked venv scripts resolve via readlink
    py=$(sed -n '1s/^#!//p' "$bin" | cut -d' ' -f1)
    [ -x "$py" ] || py="$(dirname "$(readlink -f "$bin")")/python"
    [ -x "$py" ] || py=python3
    echo "$py"
}

case "$1" in
    setup)
        mkdir -p "$DATA"
        exec "$(piper_python)" -m piper.download_voices "$VOICE" --data-dir "$DATA" ;;
    server)
        exec "$(piper_python)" -m piper.http_server -m "$VOICE" --data-dir "$DATA" --port "$PORT" ;;
    "")
        exit 0 ;;
esac

# --- synthesize to a temp WAV, then play it with a player that drains the
# audio buffer before exiting. ffplay reading from a pipe exits early on
# PipeWire and clips the end of short clips like single kana.
tmp=$(mktemp --suffix=.wav)
trap 'rm -f "$tmp"' EXIT

if curl -sf "http://localhost:$PORT/info" >/dev/null 2>&1; then
    json=$(printf '%s' "$1" | python3 -c "import json,sys; print(json.dumps({'text': sys.stdin.read().strip(), 'speaker': '$SPEAKER', 'length_scale': $LENGTH_SCALE}))")
    curl -sf -X POST -H 'Content-Type: application/json' -d "$json" "http://localhost:$PORT/synthesize" -o "$tmp"
else
    command -v piper >/dev/null || { echo "say-ja: 'piper' not found on PATH ($PATH)" >&2; exit 1; }
    sid=0; [ "$SPEAKER" = "male" ] && sid=1
    piper -m "$VOICE" --data-dir "$DATA" -s "$sid" --length-scale "$LENGTH_SCALE" -f "$tmp" -- "$1"
fi
[ -s "$tmp" ] || { echo "say-ja: no audio produced" >&2; exit 1; }

if command -v pw-play >/dev/null; then
    pw-play "$tmp"
elif command -v paplay >/dev/null; then
    paplay "$tmp"
elif command -v mpv >/dev/null; then
    mpv --no-video --really-quiet "$tmp"
elif command -v ffplay >/dev/null; then
    ffplay -nodisp -autoexit -loglevel quiet -af "apad=pad_dur=0.4" "$tmp"
else
    echo "say-ja: no player found (pw-play, paplay, mpv or ffplay)" >&2; exit 1
fi
