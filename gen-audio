#!/usr/bin/env python3
"""Build one audio clip per kana reading in HiraganaWidget/data/audio/.

Why clips instead of live TTS: every runtime engine tested (Piper, espeak-ng,
Open JTalk) falls apart on a single mora. Piper's sentence-trained voice gives a
different length every call, chops the vowel, and renders ン as a click; a
recogniser identified 5 of 104 kana.

The clips are the native-speaker recordings from Learn Japanese Adventure
(https://www.learn-japanese-adventure.com/learn-to-speak-japanese-online.html,
media-files/kanasound-<romaji>.mp3), credited in the README.

    python3 -m venv .venv && .venv/bin/pip install numpy
    .venv/bin/python gen-audio                       # all readings (network needed)
    .venv/bin/python gen-audio ka shi n              # just these

Needs ffmpeg and curl on PATH. One file per romaji reading, so hiragana and
katakana share clips and ジ/ヂ, ズ/ヅ (same sound) share too. The raw
recordings differ 8x in level and carry up to 0.7 s of lead silence, so every
clip is trimmed, peak-normalised to the same level and padded: same loudness,
short lead-in, no clipped vowel.
"""

import argparse
import json
import subprocess
import sys
import wave
from pathlib import Path

import numpy as np

HERE = Path(__file__).resolve().parent
DATA = HERE / "HiraganaWidget" / "data"
OUT = DATA / "audio"
RATE = 22050
PEAK = 0.7          # -3 dBFS, identical for every clip
THRESHOLD = 0.02    # amplitude that counts as speech when trimming
LEAD_MS, TAIL_MS = 60, 200


SITE = "https://www.learn-japanese-adventure.com/media-files/kanasound-{}.mp3"


def decode(mp3: Path) -> np.ndarray:
    pcm = subprocess.run(
        ["ffmpeg", "-loglevel", "error", "-i", str(mp3), "-f", "s16le", "-ac", "1", "-ar", str(RATE), "-"],
        check=True, capture_output=True,
    ).stdout
    mp3.unlink()
    return np.frombuffer(pcm, dtype=np.int16).astype(np.float32) / 32768


def fetch_site(reading: str) -> np.ndarray:
    mp3 = OUT / ".tmp.mp3"
    subprocess.run(["curl", "-sfL", "-A", "Mozilla/5.0", SITE.format(reading), "-o", str(mp3)], check=True)
    return decode(mp3)



def tidy(a: np.ndarray) -> np.ndarray:
    loud = np.where(np.abs(a) > THRESHOLD)[0]
    if len(loud) == 0:
        raise RuntimeError("clip is silent")
    a = a[loud[0]:loud[-1] + 1]
    a = a * (PEAK / np.abs(a).max())
    # short fades so the cut edges do not click
    n = min(len(a) // 4, RATE // 100)
    a[:n] *= np.linspace(0, 1, n)
    a[-n:] *= np.linspace(1, 0, n)
    lead = np.zeros(RATE * LEAD_MS // 1000, dtype=np.float32)
    tail = np.zeros(RATE * TAIL_MS // 1000, dtype=np.float32)
    return np.concatenate([lead, a, tail])


def write(path: Path, a: np.ndarray) -> None:
    with wave.open(str(path), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(2)
        w.setframerate(RATE)
        w.writeframes((np.clip(a, -1, 1) * 32767).astype(np.int16).tobytes())


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    ap.add_argument("readings", nargs="*", help="romaji readings to (re)render; default: all")
    args = ap.parse_args()

    kana = json.loads((DATA / "kana.json").read_text())
    # hiragana spelling for the log line; the reading is the file name
    by_reading = {}
    for k in sorted(kana, key=lambda k: k["set"] != "hiragana"):   # hiragana first
        by_reading.setdefault(k["romaji"], k["kana"])
    wanted = args.readings or sorted(by_reading)
    unknown = [r for r in wanted if r not in by_reading]
    if unknown:
        sys.exit(f"not in kana.json: {' '.join(unknown)}")

    OUT.mkdir(parents=True, exist_ok=True)
    for reading in wanted:
        text = by_reading[reading]
        a = tidy(fetch_site(reading))
        write(OUT / f"{reading}.wav", a)
        print(f"{text}\t{reading}.wav\t{len(a) / RATE:.2f}s")
    return 0


if __name__ == "__main__":
    sys.exit(main())
